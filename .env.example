APP_NAME=ClauseGuard RAG AI
PIPELINE_VERSION=2026.07-advanced-score-v2
ENVIRONMENT=development
DATABASE_URL=sqlite:///./clauseguard.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=clauseguard_policies
QDRANT_CLAUSE_COLLECTION=clauseguard_contract_clauses
QDRANT_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CONTRACT_RETRIEVAL_MIN_SCORE=0.18
POLICY_RETRIEVAL_MIN_SCORE=0.15
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
LLM_RISK_SECOND_PASS_ENABLED=false
LLM_RISK_MIN_CONFIDENCE=0.70
LLM_FINDING_VERIFICATION_ENABLED=true
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
